{
  "name": "rmate-vscode",
  "displayName": "RMate for VS Code",
  "description": "A VS Code extension that provides a server compatible with TextMate's `rmate` CLI.",
  "version": "1.1.1",
  "packageManager": "pnpm@10.15.1",
  "publisher": "duncannah",
  "license": "MIT",
  "author": "duncannah (https://github.com/duncannah)",
  "contributors": [
    "Simon Christmann <simon@christmann.email> (https://github.com/dersimn)",
    "Rafael Maiolla <rafaelmaiolla@gmail.com>",
    "Kevin Yarosh (https://github.com/ComfyDust)",
    "Roy Ivy III (https://github.com/rivy)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/duncannah/rmate-vscode.git"
  },
  "homepage": "https://github.com/duncannah/rmate-vscode#readme",
  "bugs": {
    "url": "https://github.com/duncannah/rmate-vscode/issues"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "keywords": [
    "rmate",
    "Visual Studio Code",
    "VS Code"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "RMate for VS Code",
      "properties": {
        "remote.port": {
          "type": "number",
          "default": 52698,
          "description": "Port number to use for connection."
        },
        "remote.onstartup": {
          "type": "boolean",
          "default": false,
          "description": "Launch the server on start up."
        },
        "remote.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Address to listen on."
        },
        "remote.showPortAlreadyInUseError": {
          "type": "boolean",
          "default": true,
          "description": "If set to false, error for remote.port already in use won't be shown anymore."
        }
      }
    },
    "commands": [
      {
        "command": "extension.startServer",
        "title": "rmate: Start Server"
      },
      {
        "command": "extension.stopServer",
        "title": "rmate: Stop Server"
      },
      {
        "command": "extension.restartServer",
        "title": "rmate: Restart Server"
      },
      {
        "command": "extension.closeDocument",
        "title": "rmate: Close Document"
      },
      {
        "command": "extension.closeAllDocuments",
        "title": "rmate: Close all open Documents"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "vsix": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/src/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.3",
    "@types/node": "18.x",
    "@types/vscode": "^1.82.0",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "@vscode/test-electron": "^2.3.6",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^8.52.0",
    "glob": "^10.3.10",
    "mocha": "^10.2.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.2.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
